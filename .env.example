# Keep the broker on loopback. Put Tailscale Serve or another authenticated
# HTTPS gateway in front of it instead of exposing this port directly.
HOST=127.0.0.1
PORT=8787

# The externally reachable HTTPS address used in the one-time pairing QR code.
# Example: https://your-mac.tailnet-name.ts.net
PUBLIC_URL=https://your-mac.tailnet-name.ts.net

# Absolute project directories that the phone may select. On macOS, separate
# multiple paths with a colon.
CODEX_POCKET_ROOTS=/absolute/path/to/project-one:/absolute/path/to/project-two

# Optional when `codex` is not already on PATH.
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
