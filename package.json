{
  "name": "codex-pocket",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile-first, local-only web broker for Codex app-server.",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "check": "node --check src/server.mjs && node --check public/app.js && node --check public/setup.js && node --check scripts/macos-service.mjs",
    "macos:install": "node scripts/macos-service.mjs install",
    "macos:start": "node scripts/macos-service.mjs start",
    "macos:stop": "node scripts/macos-service.mjs stop",
    "macos:status": "node scripts/macos-service.mjs status",
    "macos:uninstall": "node scripts/macos-service.mjs uninstall"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.2"
  }
}
